# Docker Compose configuration.
# Copy this file to `.env` before running `docker compose up --build`.

# Database credentials used by the db, migrate, and server containers.
POSTGRES_USER=blueprint
POSTGRES_PASSWORD=blueprint
POSTGRES_DB=blueprint

# Long random string. Generate one with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The public URL of the Next.js app (used for auth callbacks and email links).
PUBLIC_APP_URL=http://localhost:3000

MAIL_FROM="BluePrint <no-reply@blueprint.local>"
