# Where Next.js proxies API requests. The browser never talks to Express
# directly, which keeps the session cookie first-party.
API_INTERNAL_URL=http://localhost:8000

# Base URL used by RTK Query in the browser. Proxied through Next.js so requests
# are same-origin.
NEXT_PUBLIC_API_BASE_URL=/backend

# Absolute origin used for canonical URLs, Open Graph metadata, robots.txt and
# the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
