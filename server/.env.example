# API
PORT=8000

# PostgreSQL connection string used by Prisma and pg.
DATABASE_URL="postgresql://user:password@localhost:5432/blueprint"

# Optional: integration tests derive `<database>_test` from DATABASE_URL. Set
# this to override the target explicitly.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/blueprint_test"

# Better Auth. Generate the secret with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Public origin the browser uses (the Next.js app), not the Express port:
# OAuth callbacks and emailed links are built from this value.
BETTER_AUTH_URL="http://localhost:3000"

# The single origin allowed to send credentialed requests.
CLIENT_ORIGIN="http://localhost:3000"

# Email. Leave SMTP_HOST empty in development and every message (password
# resets, invitations, assignment notices) is printed to the server log with
# its links intact. Compose wires this to Mailpit automatically.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="BluePrint <no-reply@blueprint.local>"

# Optional: enables the Google social provider when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
